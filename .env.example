# Secret key for JWT admin authentication
JWT_SECRET=mca_gtn_secure_jwt_secret_token_2026

# Admin Quick-Access PIN (Default: admin123)
ADMIN_PIN=admin123

# Admin Username and Password (Default: admin / admin123)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
